{
    "name": "@sigx/ai-agent-codex",
    "version": "0.1.0",
    "description": "Codex for @sigx/ai-agent — Codex as an Agent over the codex app-server JSON-RPC protocol: threads, turns, approvals, dynamic client tools",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch",
        "codex:generate": "node scripts/codex-generate.mjs"
    },
    "keywords": [
        "sigx",
        "signalx",
        "ai",
        "agent",
        "codex",
        "openai",
        "app-server",
        "json-rpc"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ai.git",
        "directory": "packages/ai-agent-codex"
    },
    "homepage": "https://sigx.dev/ai/",
    "bugs": {
        "url": "https://github.com/signalxjs/ai/issues"
    },
    "dependencies": {
        "@sigx/ai-agent-node": "^0.1.0"
    },
    "devDependencies": {
        "@pwrdrvr/codex-app-server-protocol": "0.153.4",
        "@sigx/ai": "workspace:*",
        "@sigx/ai-agent": "workspace:*",
        "@sigx/ai-agent-node": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/ai": "^0.1.0",
        "@sigx/ai-agent": "^0.1.0"
    }
}
