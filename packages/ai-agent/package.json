{
    "name": "@sigx/ai-agent",
    "version": "0.1.0",
    "description": "Agent layer for @sigx/ai — one provider-neutral contract for agent harnesses and our own engine: events, capabilities, policy, sessions, mockAgent",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "development": "./dist/testing.js",
            "production": "./dist/testing.prod.js",
            "import": "./dist/testing.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "ai",
        "agent",
        "agents",
        "harness",
        "acp",
        "claude-code",
        "codex"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ai.git",
        "directory": "packages/ai-agent"
    },
    "homepage": "https://sigx.dev/ai/",
    "bugs": {
        "url": "https://github.com/signalxjs/ai/issues"
    },
    "devDependencies": {
        "@sigx/ai": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/ai": "^0.1.0"
    }
}
