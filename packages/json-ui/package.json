{
    "name": "@sigx/json-ui",
    "version": "0.2.1",
    "description": "UI from JSON for SignalX — a streamable JSON UI spec, a catalog that describes and validates it, safe expressions, reactive state, pluggable async actions, and a platform-neutral renderer on @sigx/runtime-core",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./app": {
            "types": "./dist/app/index.d.ts",
            "development": "./dist/app.js",
            "production": "./dist/app.prod.js",
            "import": "./dist/app.js"
        },
        "./web": {
            "types": "./dist/web/index.d.ts",
            "development": "./dist/web.js",
            "production": "./dist/web.prod.js",
            "import": "./dist/web.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "ui",
        "json",
        "json-ui",
        "server-driven-ui",
        "generative-ui",
        "streaming",
        "lynx"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ai.git",
        "directory": "packages/json-ui"
    },
    "homepage": "https://sigx.dev/ai/",
    "bugs": {
        "url": "https://github.com/signalxjs/ai/issues"
    },
    "devDependencies": {
        "@sigx/ai": "workspace:*",
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/vite": "catalog:",
        "sigx": "catalog:",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": "^1.0.0",
        "@sigx/runtime-core": "^1.0.0"
    }
}
