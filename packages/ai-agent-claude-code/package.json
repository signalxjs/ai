{
    "name": "@sigx/ai-agent-claude-code",
    "version": "0.1.0",
    "description": "Claude Code as an @sigx/ai-agent Agent, on the official Claude Agent SDK — sessions, tool calls, permissions through the policy, client tools over MCP, resume and fork",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "ai",
        "agent",
        "claude-code",
        "claude",
        "anthropic",
        "harness"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ai.git",
        "directory": "packages/ai-agent-claude-code"
    },
    "homepage": "https://sigx.dev/ai/",
    "bugs": {
        "url": "https://github.com/signalxjs/ai/issues"
    },
    "dependencies": {
        "@sigx/ai-agent-node": "workspace:^"
    },
    "devDependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.270",
        "@sigx/ai": "workspace:*",
        "@sigx/ai-agent": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1",
        "@sigx/ai": "^0.1.0",
        "@sigx/ai-agent": "^0.1.0"
    }
}
