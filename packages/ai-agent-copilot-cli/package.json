{
    "name": "@sigx/ai-agent-copilot-cli",
    "version": "0.1.0",
    "description": "GitHub Copilot CLI for @sigx/ai-agent — the Copilot CLI as an Agent on the official @github/copilot-sdk: sessions, streaming, permissions through your policy, in-process client tools, a switchable model list",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "signalx",
        "ai",
        "agent",
        "copilot",
        "github",
        "copilot-sdk"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/ai.git",
        "directory": "packages/ai-agent-copilot-cli"
    },
    "homepage": "https://sigx.dev/ai/",
    "bugs": {
        "url": "https://github.com/signalxjs/ai/issues"
    },
    "devDependencies": {
        "@github/copilot-sdk": "1.0.13",
        "@sigx/ai": "workspace:*",
        "@sigx/ai-agent": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@github/copilot-sdk": ">=1.0.0 <2",
        "@sigx/ai": "^0.1.0",
        "@sigx/ai-agent": "^0.1.0"
    }
}
