{
    "name": "chat-example",
    "private": true,
    "type": "module",
    "description": "The @sigx/ai playground — an SSR sigx app streaming a chat over serverStream, with the provider and model picked in the UI per conversation",
    "scripts": {
        "dev": "node --env-file-if-exists=.env dev-server.mjs",
        "build": "vite build --app",
        "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --conditions=production server.mjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.127.0",
        "@sigx/ai": "workspace:*",
        "@sigx/ai-anthropic": "workspace:*",
        "@sigx/ai-openai": "workspace:*",
        "@sigx/json-ui": "workspace:*",
        "@sigx/reactivity": "catalog:",
        "@sigx/richtext": "^0.4.0",
        "@sigx/richtext-markdown": "^0.4.0",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/serialize": "catalog:",
        "@sigx/server": "catalog:",
        "@sigx/server-renderer": "catalog:",
        "openai": "^7.21.0",
        "sigx": "catalog:",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@sigx/vite": "catalog:",
        "@types/node": "^26.5.1",
        "cross-env": "^10.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.3",
        "vitest": "^4.1.5"
    }
}
