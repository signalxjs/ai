{
    "name": "agent-example",
    "private": true,
    "type": "module",
    "description": "The @sigx/ai-agent playground — open sessions against any agent, model and mode from the UI, several at once, with live config (plan mode) and a second tab that joins them all",
    "scripts": {
        "dev": "node --env-file-if-exists=.env dev-server.mjs",
        "build": "vite build --app",
        "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --conditions=production server.mjs",
        "smoke": "node smoke.mjs",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.272",
        "@anthropic-ai/sdk": "^0.125.0",
        "@sigx/ai": "workspace:*",
        "@sigx/ai-agent": "workspace:*",
        "@sigx/ai-agent-acp": "workspace:*",
        "@sigx/ai-agent-claude-code": "workspace:*",
        "@sigx/ai-agent-codex-cli": "workspace:*",
        "@sigx/ai-agent-copilot-cli": "workspace:*",
        "@sigx/ai-agent-node": "workspace:*",
        "@sigx/ai-anthropic": "workspace:*",
        "@sigx/ai-openai": "workspace:*",
        "@sigx/reactivity": "catalog:",
        "@sigx/runtime-core": "catalog:",
        "@sigx/runtime-dom": "catalog:",
        "@sigx/serialize": "catalog:",
        "@sigx/server": "catalog:",
        "@sigx/server-renderer": "catalog:",
        "openai": "^7.15.0",
        "sigx": "catalog:",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@sigx/vite": "catalog:",
        "@types/node": "^26.5.1",
        "cross-env": "^10.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.3",
        "vitest": "^4.1.5"
    }
}
