# agent-example — copy to `.env` and uncomment what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is not, so keep real keys out of it. The
# `dev` and `start` scripts load `.env` with node's `--env-file-if-exists`,
# so a missing file is fine — everything below is OPTIONAL, and with nothing
# set the example runs our own engine on the scripted `mockModel`.

# ── Agent ───────────────────────────────────────────────────────────────────
# 'sigx' (our engine, via modelAgent) | 'claude-code' (the real harness,
# through @sigx/ai-agent-claude-code, on your own Claude Code login).
# Unset = sigx. An unavailable harness falls back to sigx with a warning.
#AI_AGENT=claude-code

# ── Model (AI_AGENT=sigx only) ──────────────────────────────────────────────
# 'anthropic' | 'openai' | 'mock'. Unset = inferred: anthropic if
# ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else mock.
#AI_PROVIDER=anthropic

# Model id for the chosen provider. Unset = that provider's default:
# claude-opus-5 (anthropic) / gpt-5 (openai).
#AI_MODEL=claude-opus-5

# ── Keys ────────────────────────────────────────────────────────────────────
# The VALUE is read only by the official SDKs — but the PRESENCE of a key is
# what picks the provider when AI_PROVIDER is unset (agent.server.ts, and the
# banner dev-server.mjs prints). Neither reaches the browser: vite.config.ts
# swaps agent.server.ts for a stub in the client build.
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-proj-...

# ── Server ──────────────────────────────────────────────────────────────────
# Port for both dev-server.mjs and server.mjs. Unset = 5320.
#PORT=5320
